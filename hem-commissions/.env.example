# Скопируйте в .env и заполните. Файл .env не коммитится.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=commissions.example.kz
DJANGO_CSRF_TRUSTED_ORIGINS=https://commissions.example.kz
SITE_URL=https://commissions.example.kz
ORGANIZATION_NAME=ТОО «Центр гематологии»
TIME_ZONE=Asia/Almaty

# PostgreSQL (в docker-compose хост подставляется автоматически)
DATABASE_NAME=commissions
DATABASE_USER=commissions
DATABASE_PASSWORD=

# S3-совместимое хранилище на территории РК. Пусто — файлы хранятся локально в MEDIA_ROOT.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_URL_TTL_SECONDS=300
MAX_UPLOAD_MB=100

# Почта (уведомления, коды подтверждения подписи, восстановление пароля)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=commissions@example.kz

# Безопасность
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30
SESSION_IDLE_TIMEOUT_MINUTES=30
OTP_TTL_MINUTES=10

# WhatsApp через n8n (опционально): вебхук принимает JSON {"phone": "...", "text": "..."}
N8N_WHATSAPP_WEBHOOK_URL=

# Мониторинг adilet.zan.kz
ADILET_CHECK_ENABLED=1
ADILET_TIMEOUT_SECONDS=40

# Транскрипция (сервис в РК или локальная модель). Пусто — не настроена.
TRANSCRIPTION_BACKEND=
TRANSCRIPTION_URL=
